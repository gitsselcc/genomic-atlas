---
import type { Area } from '../types';
interface Props { area: Area; }
const { area } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<a class="card" href={`${base}/areas/${area.id}/`} aria-label={`Explorar ${area.name}`}>
  <span class="kicker">Campo científico</span>
  <h3>{area.name}</h3>
  <p>{area.description}</p>
  <small>{area.subareas.length} subespecialidades · Explorar →</small>
</a>
