---
import '../styles/global.css';
interface Props { title: string; description?: string; }
const { title, description = 'Explora campos científicos y oportunidades de investigación para estudiantes de ciencias genómicas.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (page: string) => `${base}${page}`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#081820" />
    <link rel="icon" type="image/svg+xml" href={path('/favicon.svg')} />
    <title>{title} · Genomic Atlas</title>
  </head>
  <body>
    <header class="shell topbar">
      <a href={path('/')} class="brand" aria-label="Genomic Atlas: inicio"><span class="brandmark">◈</span> Genomic Atlas</a>
      <nav class="nav" aria-label="Navegación principal">
        <a href={path('/areas/')}>Áreas científicas</a>
        <a href={path('/oportunidades/')}>Oportunidades</a>
        <a href={path('/sobre/')}>Proyecto</a>
        <a href={path('/contribuir/')}>Contribuir</a>
      </nav>
    </header>
    <main class="shell"><slot /></main>
    <footer class="foot"><div class="shell">Genomic Atlas · Proyecto abierto, en desarrollo · La elegibilidad y los plazos deben verificarse en fuentes oficiales.</div></footer>
  </body>
</html>
